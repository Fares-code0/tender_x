# PostgreSQL (docker compose أو pnpm db:start)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tender_dev"

# JWT
# في الإنتاج (NODE_ENV=production) يجب أن يكون سرًّا عشوائيًا لا يقل عن 16 حرفًا،
# وليس إحدى القيم الافتراضية المعروفة — وإلا يفشل الإقلاع (H0.1).
# توليد: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# H0.2 — عدد قفزات البروكسي الموثوق أمام التطبيق (0 = لا بروكسي، 1 = بروكسي واحد/LB)
TRUST_PROXY=1

# Redis (H2.1) — عند ضبطه يصبح تحديد المعدل موزّعًا ومشتركًا بين كل النسخ.
# بدونه يعمل التطبيق بمخزن داخل الذاكرة: كافٍ لنسخة واحدة فقط، وغير صالح للنشر الأفقي.
# REDIS_URL="redis://localhost:6379"

# H2.2 — الحد العام لكل IP (كل المسارات عدا /health و /livez و /readyz)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# H2.2 — حد محاولات تسجيل الدخول لكل IP (حماية من التخمين).
# الافتراضي: 5 محاولات/15 دقيقة في الإنتاج والاختبار، و50 في التطوير فقط
# (المطوّر يسجّل الدخول مرارًا فيحجب نفسه). لا ترفعه في الإنتاج.
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# H2.3 / S4 — تأخير متصاعد بعد محاولات دخول فاشلة متتالية (لا قفل ثابت).
# عند بلوغ الحد تُقفل ٣٠ ثانية، ثم تتضاعف النافذة مع كل محاولة فاشلة بعدها
# (٣٠ث ⇒ دقيقة ⇒ دقيقتان…) حتى السقف أدناه. الدخول الناجح يصفّر العدّاد.
# ملاحظة: LOGIN_LOCK_MINUTES صار **سقف** النافذة لا طولها الثابت.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# H3.1 — مستوى التسجيل: fatal|error|warn|info|debug|trace|silent
# الافتراضي: info (و silent في الاختبارات)
LOG_LEVEL=info

# H4.4 — تجمّع اتصالات Prisma (يُضافان إلى DATABASE_URL إن لم يكونا فيه أصلًا).
# القاعدة: connection_limit × عدد النسخ ≤ max_connections في PostgreSQL.
# DB_CONNECTION_LIMIT=10
# DB_POOL_TIMEOUT=10
#
# خلف PgBouncer (وضع transaction): ضع pgbouncer=true داخل DATABASE_URL نفسه
# واضبط connection_limit=1 لكل نسخة — التجميع مسؤولية PgBouncer لا Prisma. مثال:
# DATABASE_URL="postgresql://user:pass@pgbouncer:6432/tender?pgbouncer=true&connection_limit=1"

# H5.1 — تخزين المرفقات على Amazon S3 (إلزامي للنشر بأكثر من نسخة:
# القرص المحلي يجعل مرفق النسخة A غير مرئي للنسخة B).
# عند ضبط S3_BUCKET يُستخدم S3 تلقائيًا، وإلا يبقى القرص المحلي (تطوير/نسخة واحدة).
# S3_BUCKET="tender-attachments"
# S3_PREFIX="attachments/"
# AWS_REGION="me-south-1"
#
# ⚠️ لا تضع مفاتيح AWS في الكود إطلاقًا. العميل يقرأ الاعتماديات من السلسلة الافتراضية:
#   - الإنتاج (المفضّل): دور IAM للمهمة/الخادم — بلا مفاتيح طويلة الأمد على الإطلاق
#   - محليًا: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY في بيئتك أو ~/.aws/credentials
# صلاحيات الدور المطلوبة على الحاوية: s3:PutObject, s3:GetObject, s3:DeleteObject

# H5.3 — مدة صلاحية كاش القراءات الساخنة (ثوانٍ). يتطلب REDIS_URL.
CACHE_TTL_SECONDS=30

# H6.4 / S5 — صفحة التوثيق (/docs) و/openapi.json.
# **الافتراض false**: كشفها اشتراك صريح لا نسيان. مفعّلة هنا للتطوير المحلي؛
# لا تفعّلها على نطاق عام — المخطّط يعطي المهاجم خريطة المسارات وأشكال الطلبات.
DOCS_ENABLED=true
