# نموذج بيئة **النشر المحمول** (`docker-compose.prod.yml`) على خادم مملوك.
#
# ⚠️ الإنتاج على **Render**، وهناك لا يُستعمل هذا الملف إطلاقًا: المتغيّرات
# تُضبط في `render.yaml` أو لوحة Render. راجع `docs/operations/deployment.md`.
#
# انسخه على الخادم إلى `.env.production` واملأه.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# ⚠️ لا تُودِع `.env.production` في المستودع أبدًا — `.gitignore` يمنعه،
# والقيم هنا **أمثلة لا أسرار**. ولّد كل سرّ على الخادم لا على جهازك.

# ---------- النطاق ----------
# بلا بروتوكول: Caddy يبني منه عنوان الموقع، والـAPI يبني منه WEB_ORIGIN.
SITE_ADDRESS=tender.example.com

# ملاحظة: لا يلزم بريد ACME — Caddy يُصدر الشهادة ويجدّدها تلقائيًا لاسم
# مضيف حقيقي. الثمن: لا تصلك تنبيهات قرب الانتهاء، والتجديد التلقائي هو
# الضمانة الوحيدة. على Render لا يعنيك هذا أصلًا: TLS عند حافة المنصّة.

# ---------- قاعدة البيانات ----------
POSTGRES_USER=tender
POSTGRES_DB=tender
# ولّدها على الخادم:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# المضيف `db` هو اسم الخدمة في compose لا عنوانًا خارجيًا.
# يجب أن تطابق المستخدم/الكلمة/القاعدة أعلاه حرفيًا.
DATABASE_URL=postgresql://tender:CHANGE_ME@db:5432/tender

# H4.4 — تجمّع الاتصالات. القاعدة: connection_limit × عدد النسخ ≤ max_connections
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10

# ---------- الأسرار ----------
# ولّده على الخادم:  openssl rand -hex 32
# الإقلاع يفشل فورًا (H0.1) إن كان افتراضيًا أو أقصر من 16 حرفًا.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# ---------- تحديد المعدل وقفل الحساب ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- السجلات ----------
LOG_LEVEL=info

# ---------- اختياري ----------
# Redis (H2.1) — غير مطلوب لنسخة واحدة؛ يلزم عند التوسّع الأفقي فقط.
# REDIS_URL=redis://redis:6379

# S3 للمرفقات (H5.1) — بدونه تُحفظ على قرص الحاوية في حجم `tender_uploads`.
# يلزم عند تشغيل أكثر من نسخة: قرص النسخة A غير مرئي للنسخة B.
# S3_BUCKET=tender-attachments
# AWS_REGION=me-south-1

# H6.4 — أخفِ توثيق الـAPI على نطاق عام
DOCS_ENABLED=false
