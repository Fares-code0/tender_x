# D1 — أصل واحد: الواجهة والـAPI خلف نفس المضيف والمنفذ.
#
# ليس تفضيلًا تشغيليًا بل شرط معماري: `apps/web/src/api/client.ts` يعرّف
# `API_BASE = '/api/v1'` (مسار نسبي)، وكوكي الجلسة على `sameSite=strict`.
# فالنشر على أصلين لا يعطي خطأً واضحًا بل **يُسقط المصادقة بصمت**.

{
	# منافذ غير محجوزة ليعمل Caddy بمستخدم غير جذر بلا CAP_NET_BIND_SERVICE.
	# التوجيه من 80/443 يجري في compose.
	http_port 8080
	https_port 8443

	# سجلّ منظَّم كسجلات الـAPI (pino) — شرط أي تجميع سجلات مركزي
	log {
		format json
	}
}

# عنوان الموقع من البيئة، وهو وحده ما يحدّد سلوك TLS — بلا توجيه `tls`
# صريح، لأن HTTPS التلقائي في Caddy يستنتج الصحيح من شكل العنوان:
#
#   | البيئة        | SITE_ADDRESS        | النتيجة                          |
#   | محليًا و CI   | localhost (افتراضي) | شهادة من هيئة Caddy الداخلية      |
#   | خادم مملوك    | tender.example.com  | شهادة Let's Encrypt تلقائية       |
#   | Render        | :10000              | HTTP عاديّ — **بلا شهادة**        |
#
# الأخير مقصود: Render ينهي TLS عند حافته ويمرّر HTTP إلى المنفذ الداخلي.
# عنوان بلا اسم مضيف يُعطّل HTTPS التلقائي لهذا الموقع — فلا يحاول Caddy
# طلب شهادة لشيء لا اسم له، ولا نحتاج توجيهًا شرطيًا لا يدعمه Caddyfile.
{$SITE_ADDRESS:localhost} {
	encode gzip

	# ---------- الـAPI ----------
	# البادئة `/api` تُحذف قبل التمرير، تمامًا كما يفعل بروكسي Vite في
	# التطوير (`apps/web/vite.config.ts`). بدون الحذف يصل المسار
	# `/api/v1/tenders` إلى الـAPI فيردّ 404 على كل نداء.
	# الوجهة من البيئة: `api:4000` اسم الخدمة في compose، وعلى Render اسم
	# الخدمة الخاصة ومنفذها (`tender-api:4000`) — تصل عبر الشبكة الداخلية
	# وحدها، فالـAPI لا يُعرَّض للإنترنت في أي بيئة.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy {$API_UPSTREAM:api:4000} {
			# الـAPI على `trust proxy` (H0.2) فيقرأ هذه ليصح `req.ip`
			# في تحديد المعدل، و`secure` في الكوكي.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# ---------- الواجهة ----------
	handle {
		root * /srv

		# ارتداد SPA: التوجيه في المتصفح لا على الخادم، فتحديث الصفحة على
		# `/tenders/5` يطلب مسارًا لا ملف له. بدون هذا ⇒ 404 عند كل تحديث.
		try_files {path} /index.html
		file_server
	}
}
